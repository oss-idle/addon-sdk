{
  "name": "oss-idle-addon-sdk-repo",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "oss!idle Addon SDK and its scaffolder.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oss-idle/addon-sdk.git"
  },
  "workspaces": [
    "packages/addon-sdk",
    "packages/addon-sdk-create"
  ],
  "scripts": {
    "build": "npm -w @oss-idle/addon-sdk run build",
    "dev": "npm -w @oss-idle/addon-sdk run dev",
    "test": "node scripts/settings-test.mjs && node scripts/bridge-test.mjs && node scripts/scaffold-test.mjs",
    "verify": "npm run build && npm test",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "sql.js": "^1.14.1",
    "typescript": "^5.6.3"
  }
}
